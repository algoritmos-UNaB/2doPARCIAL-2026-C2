import struct
from pathlib import Path
from ejercicio_1 import Receta
from ejercicio_2 import LibroRecetas
from ejercicio_9 import ArchivoInvalidoError

FORMATO = struct.Struct("<I32sH8s16s")  
HEADER = struct.Struct("<4scI")        
TEMA = b"R"


def _a_bytes(texto, ancho):
    return texto.encode("utf-8")[:ancho].ljust(ancho, b"\x00")


def _a_texto(datos):
    return datos.rstrip(b"\x00").decode("utf-8")


def _receta_a_tupla(r):
    return (
        r.id,
        _a_bytes(r.nombre, 32),
        r.tiempo_min,
        _a_bytes(r.dificultad, 8),
        _a_bytes(r.categoria, 16),
    )


def _tupla_a_receta(t):
    return Receta(
        t[0],
        _a_texto(t[1]),
        t[2],
        _a_texto(t[3]),
        _a_texto(t[4]),
    )


def guardar_binario(ruta, libro):
    recetas = libro.listar()
    with open(ruta, "wb") as archivo:
        archivo.write(HEADER.pack(b"AYED", TEMA, len(recetas)))
        for receta in recetas:
            archivo.write(FORMATO.pack(*_receta_a_tupla(receta)))


def cargar_binario(ruta):
    if not Path(ruta).exists():
        raise ArchivoInvalidoError("No existe el archivo.")

    with open(ruta, "rb") as archivo:
        cabecera = archivo.read(HEADER.size)
        if len(cabecera) < HEADER.size:
            raise ArchivoInvalidoError("Binario incompleto: ni siquiera tiene header completo.")
        magia, tema, cantidad = HEADER.unpack(cabecera)
        if magia != b"AYED":
            raise ArchivoInvalidoError("Magia incorrecta.")
        if tema != TEMA:
            raise ArchivoInvalidoError("Tema incorrecto.")

        libro = LibroRecetas()
        for _ in range(cantidad):
            datos = archivo.read(FORMATO.size)
            if len(datos) < FORMATO.size:
                raise ArchivoInvalidoError("Binario incompleto: faltan registros.")
            libro.agregar(_tupla_a_receta(FORMATO.unpack(datos)))
        return libro


def actualizar_registro(ruta, posicion, receta):
    if not Path(ruta).exists():
        raise ArchivoInvalidoError("No existe el archivo.")

    with open(ruta, "r+b") as archivo:
        cabecera = archivo.read(HEADER.size)
        if len(cabecera) < HEADER.size:
            raise ArchivoInvalidoError("Binario incompleto: ni siquiera tiene header completo.")
        magia, tema, cantidad = HEADER.unpack(cabecera)
        if magia != b"AYED" or tema != TEMA:
            raise ArchivoInvalidoError("Encabezado invalido.")
        if posicion < 0 or posicion >= cantidad:
            raise ArchivoInvalidoError("Posicion fuera de rango.")

        archivo.seek(HEADER.size + posicion * FORMATO.size)
        archivo.write(FORMATO.pack(*_receta_a_tupla(receta)))

#TEORIA: El tamaño fijo del encabezado (9 bytes) y de cada registro (62 bytes) permite calcular el byte exacto donde empieza el registro mediante `HEADER.size + posicion * FORMATO.size` para ir directo con `seek()`.