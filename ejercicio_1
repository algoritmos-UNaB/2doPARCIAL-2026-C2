class Receta:
    def __init__(self, id: int, nombre: str, tiempo_min: int, dificultad: str, categoria: str):
        self.id = id
        self.nombre = nombre
        self.tiempo_min = tiempo_min
        self.dificultad = dificultad
        self.categoria = categoria

    def __str__(self) -> str:
        return f"#{self.id} {self.nombre} – {self.tiempo_min} min, {self.dificultad}, {self.categoria}"

    def __eq__(self, other: object):
        if not isinstance(other, Receta):
            return False
        return self.id == other.id
        
#TEORIA: El atributo que define la identidad de la receta es `id`, mientras que el estado esta compuesto por `nombre`, `tiempo_min`, `dificultad` y `categoria`; no, la identidad no deberia poder cambiar despues de construido el objeto porque permite identificar univocamente a la entidad a lo largo de su ciclo de vida.