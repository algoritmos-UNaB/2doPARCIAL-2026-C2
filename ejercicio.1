
class Pokémon:
    def __init__(self, id, nombre, tipo1, tipo2, hp, ataque, defensa, velocidad, generacion):
        self.id = id
        self.nombre = nombre
        self.tipo1 = tipo1
        self.tipo2 = tipo2
        self.hp = hp
        self.ataque = ataque
        self.defensa = defensa
        self.velocidad = velocidad
        self.generacion = generacion

    def __str__(self):
        if self.tipo2 and self.tipo2 != "":
            return f"#{self.id} {self.nombre} ({self.tipo1}/{self.tipo2})"
        else:
            return f"#{self.id} {self.nombre} ({self.tipo1})"

    def __eq__(self, otro):
        if isinstance(otro, Pokémon):
            return self.id == otro.id
        return False
