class ArchivoInvalidoError(Excepcion):
    pass

def guardar_csv(ruta, pokedex):
    with open(ruta, mode='w', encoding='utf-8', newline='') as archivo:
        escritor = csv.writer(archivo)
        escritor.writerow(['id', 'nombre', 'tipo1', 'tipo2', 'hp', 'ataque', 'defensa', 'velocidad', 'generacion'])
        for p in pokedex.listar():
            escritor.writerow([p.id, p.nombre, p.tipo1, p.tipo2, p.hp, p.ataque, p.defensa, p.velocidad, p.generacion])

def cargar_csv(ruta):
    pokedex = Pokedex()
    try:
        with open(ruta, mode='r', encoding='utf-8') as archivo:
            lector = csv.reader(archivo)
            encabezado = next(lector, None)
            if not encabezado or len(encabezado) < 9:
                raise ArchivoInvalidoError("El archivo no tiene encabezado válido.")
            
            for fila in lector:
                if len(fila) != 9:
                    raise ArchivoInvalidoError("Una fila no tiene 9 columnas.")
                try:
                    p = Pokémon(
                        id=int(fila[0]),
                        nombre=fila[1],
                        tipo1=fila[2],
                        tipo2=fila[3],
                        hp=int(fila[4]),
                        ataque=int(fila[5]),
                        defensa=int(fila[6]),
                        velocidad=int(fila[7]),
                        generacion=int(fila[8])
                    )
                    pokedex.agregar(p)
                except ValueError:
                    raise ArchivoInvalidoError("Error al convertir tipos numéricos en el CSV.")
    except FileNotFoundError:
        raise ArchivoInvalidoError("No se encontró el archivo CSV.")
    return pokedex
