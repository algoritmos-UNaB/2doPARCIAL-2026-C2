def _clave(pokemon, campo):
    if campo == "ataque":
        return pokemon.ataque
    if campo == "velocidad":
        return pokemon.velocidad
    if campo == "nro":
        return pokemon.id
    raise ValueError(f"Campo no soportado: {campo}")


def _va_antes(a, b, descendente):
    """True si a debe ir estrictamente antes que b."""
    return a > b if descendente else a < b


def ordenar_seleccion(pokemones, campo, descendente=False):
    n = len(pokemones)
    for i in range(n - 1):
        elegido = i
        for j in range(i + 1, n):
            if _va_antes(_clave(pokemones[j], campo),
                         _clave(pokemones[elegido], campo), descendente):
                elegido = j
        pokemones[i], pokemones[elegido] = pokemones[elegido], pokemones[i]
    return pokemones


def ordenar_insercion(pokemones, campo, descendente=False):
    for i in range(1, len(pokemones)):
        actual = pokemones[i]
        k = _clave(actual, campo)
        j = i - 1
        while j >= 0 and _va_antes(k, _clave(pokemones[j], campo), descendente):
            pokemones[j + 1] = pokemones[j]
            j -= 1
        pokemones[j + 1] = actual
    return pokemones


# El estable es el de insercion el de seleccion no, porque su
# intercambio a distancia puede saltar sobre elementos iguales. 

# Estable significa que los elementos con la misma clave conservan entre si el orden
# relativo que tenian antes de ordenar.