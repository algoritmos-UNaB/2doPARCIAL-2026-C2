from ejercicio_02 import PokemonNoEncontrado


class EquipoLlenoError(Exception):
    pass


class Nodo:
    def __init__(self, dato):
        self.dato = dato
        self.siguiente = None


class ListaEnlazada:
    def __init__(self):
        self._cabeza = None
        self._tamanio = 0

    def esta_vacia(self):
        return self._cabeza is None

    def tamanio(self):
        return self._tamanio

    def insertar_al_inicio(self, dato):
        nuevo = Nodo(dato)
        nuevo.siguiente = self._cabeza
        self._cabeza = nuevo
        self._tamanio += 1

    def insertar_al_final(self, dato):
        nuevo = Nodo(dato)
        if self._cabeza is None:
            self._cabeza = nuevo
        else:
            actual = self._cabeza
            while actual.siguiente is not None:
                actual = actual.siguiente
            actual.siguiente = nuevo
        self._tamanio += 1

    def quitar_primero(self):
        """Saca el primer nodo y devuelve su dato (None si la lista esta vacia)."""
        if self._cabeza is None:
            return None
        nodo = self._cabeza
        self._cabeza = nodo.siguiente
        self._tamanio -= 1
        return nodo.dato

    def ver_primero(self):
        """Devuelve el dato del primer nodo sin sacarlo (None si esta vacia)."""
        if self._cabeza is None:
            return None
        return self._cabeza.dato

    def eliminar(self, id):
        """Quita el primer nodo cuyo dato.id sea id. True si lo quito."""
        anterior = None
        actual = self._cabeza
        while actual is not None:
            if actual.dato.id == id:
                if anterior is None:
                    self._cabeza = actual.siguiente
                else:
                    anterior.siguiente = actual.siguiente
                self._tamanio -= 1
                return True
            anterior = actual
            actual = actual.siguiente
        return False

    def buscar(self, id):
        actual = self._cabeza
        while actual is not None:
            if actual.dato.id == id:
                return actual.dato
            actual = actual.siguiente
        return None

    def __iter__(self):
        actual = self._cabeza
        while actual is not None:
            yield actual.dato
            actual = actual.siguiente


class Equipo:
    MAXIMO = 6

    def __init__(self):
        self._lista = ListaEnlazada()

    def agregar(self, pokemon):
        if self._lista.tamanio() >= Equipo.MAXIMO:
            raise EquipoLlenoError(f"El equipo ya tiene {Equipo.MAXIMO} Pokemon")
        self._lista.insertar_al_final(pokemon)

    def quitar(self, id):
        if not self._lista.eliminar(id):
            raise PokemonNoEncontrado(f"El id {id} no esta en el equipo")

    def cantidad(self):
        return self._lista.tamanio()

    def __iter__(self):
        return iter(self._lista)


# En una lista enlazada simple no hay referencia "hacia atras" la unica
# forma de llegar al penultimo es recorrer desde la cabeza hasta el nodo cuyo
# atributo siguiente apunta al ultimo, ese atributo siguiente del penultimo es
# el que hay que modificar (ponerlo en None).