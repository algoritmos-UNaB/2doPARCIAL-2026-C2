
class ErrorDePilaVacia(Excepcion):
    pass

class Pila:
    def __init__(self):
        self.elementos = ListaEnlazada()

    def esta_vacia(self):
        return self.elementos.esta_vacia()

    def apilar(self, dato):
        self.elementos.insertar_al_inicio(dato)

    def desapilar(self):
        if self.esta_vacia():
            raise ErrorDePilaVacia("La pila está vacía.")
        return self.elementos.quitar_primero()

    def ver_tope(self):
        if self.esta_vacia():
            raise ErrorDePilaVacia("La pila está vacía.")
        return self.elementos.cabeza.dato

class AccionesHistoricas:
    def __init__(self):
        self.pila = Pila()

    def registrar(self, accion):
        self.pila.apilar(accion)

    def deshacer(self):
        if self.pila.esta_vacia():
            raise ErrorDePilaVacia("No hay acciones para deshacer.")
        return self.pila.desapilar()

    def ultima(self):
        if self.pila.esta_vacia():
            raise ErrorDePilaVacia("No hay acciones registradas.")
        return self.pila.ver_tope()
