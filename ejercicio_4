from ejercicio_2 import RecetaNoEncontrada


class Nodo:
    def __init__(self, dato):
        self.dato = dato
        self.siguiente = None


class ListaEnlazada:
    def __init__(self):
        self.primero = None
        self.ultimo = None
        self._tamanio = 0

    def esta_vacia(self):
        return self.primero is None

    def tamanio(self):
        return self._tamanio

    def insertar_al_inicio(self, dato):
        nuevo = Nodo(dato)
        if self.esta_vacia():
            self.primero = nuevo
            self.ultimo = nuevo
        else:
            nuevo.siguiente = self.primero
            self.primero = nuevo
        self._tamanio += 1

    def insertar_al_final(self, dato):
        nuevo = Nodo(dato)
        if self.esta_vacia():
            self.primero = nuevo
            self.ultimo = nuevo
        else:
            self.ultimo.siguiente = nuevo
            self.ultimo = nuevo
        self._tamanio += 1

    def quitar_primero(self):
        if self.esta_vacia():
            raise IndexError("La lista enlazada esta vacia")
        dato = self.primero.dato
        self.primero = self.primero.siguiente
        if self.primero is None:
            self.ultimo = None
        self._tamanio -= 1
        return dato

    def eliminar_donde(self, condicion):
        anterior = None
        actual = self.primero

        while actual is not None:
            if condicion(actual.dato):
                if anterior is None:
                    self.primero = actual.siguiente
                else:
                    anterior.siguiente = actual.siguiente

                if actual is self.ultimo:
                    self.ultimo = anterior

                self._tamanio -= 1
                return True

            anterior = actual
            actual = actual.siguiente

        return False

    def __iter__(self):
        actual = self.primero
        while actual is not None:
            yield actual.dato
            actual = actual.siguiente

class MenuSemanal:
    Dias_Validos = ("lunes", "martes", "miercoles", "jueves", "viernes", "sabado", "domingo")

    def __init__(self):
        self.items = ListaEnlazada()

    def agregar(self, dia, receta):
        if dia not in self.Dias_Validos:
            raise ValueError(f"Dia invalido: {dia}")

        actual = self.items.primero
        while actual is not None:
            if actual.dato[0] == dia:
                actual.dato = (dia, receta)
                return
            actual = actual.siguiente

        self.items.insertar_al_final((dia, receta))

    def quitar(self, dia):
        def es_el_dia(par):
            return par[0] == dia

        eliminado = self.items.eliminar_donde(es_el_dia)
        if not eliminado:
            raise RecetaNoEncontrada(f"No hay receta asignada para el dia {dia}")

    def receta_de(self, dia):
        for d, receta in self.items:
            if d == dia:
                return receta
        raise RecetaNoEncontrada(f"No hay receta asignada para el dia {dia}")

    def __iter__(self):
        return iter(self.items)

#TEORIA: En una lista enlazada simple no existe una referencia directa al penultimo nodo, ya que cada nodo solo apunta hacia adelante (siguiente). Esa referencia unicamente se encuentra en el atributo `siguiente` del nodo antepenultimo, por lo que para obtenerla hay que recorrer la lista secuencialmente desde el inicio hasta encontrar el nodo cuyo `siguiente` sea el ultimo.