class ErrorDeColaVacia(Excepcion):
    pass

class Cola:
    def __init__(self):
        self.elementos = ListaEnlazada()

    def esta_vacia(self):
        return self.elementos.esta_vacia()

    def encolar(self, dato):
        self.elementos.insertar_al_final(dato)

    def desencolar(self):
        if self.esta_vacia():
            raise ErrorDeColaVacia("La cola está vacía.")
        return self.elementos.quitar_primero()

    def ver_frente(self):
        if self.esta_vacia():
            raise ErrorDeColaVacia("La cola está vacía.")
        return self.elementos.cabeza.dato

class ColaTurnos:
    def __init__(self):
        self.cola = Cola()

    def encolar(self, pokemon):
        self.cola.encolar(pokemon)

    def siguiente(self):
        if self.cola.esta_vacia():
            raise ErrorDeColaVacia("No hay Pokémon en espera.")
        return self.cola.desencolar()

    def proximo(self):
        if self.cola.esta_vacia():
            raise ErrorDeColaVacia("No hay Pokémon en espera.")
        return self.cola.ver_frente()
