class Nodo:
    def __init__(self, dato):
        self.dato = dato
        self.siguiente = None

class ListaEnlazada:
    def __init__(self):
        self.cabeza = None
        self._tamanio = 0

    def esta_vacia(self):
        return self.cabeza is None

    def tamanio(self):
        return self._tamanio

    def insertar_al_inicio(self, dato):
        nuevo = Nodo(dato)
        nuevo.siguiente = self.cabeza
        self.cabeza = nuevo
        self._tamanio += 1

    def insertar_al_final(self, dato):
        nuevo = Nodo(dato)
        if self.esta_vacia():
            self.cabeza = nuevo
        else:
            actual = self.cabeza
            while actual.siguiente is not None:
                actual = actual.siguiente
            actual.siguiente = nuevo
        self._tamanio += 1

    def quitar_primero(self):
        if self.esta_vacia():
            return None
        dato = self.cabeza.dato
        self.cabeza = self.cabeza.siguiente
        self._tamanio -= 1
        return dato

    def eliminar(self, id):
        if self.esta_vacia():
            return False
        if self.cabeza.dato.id == id:
            self.cabeza = self.cabeza.siguiente
            self._tamanio -= 1
            return True
        actual = self.cabeza
        while actual.siguiente is not None:
            if actual.siguiente.dato.id == id:
                actual.siguiente = actual.siguiente.siguiente
                self._tamanio -= 1
                return True
            actual = actual.siguiente
        return False

    def buscar(self, id):
        actual = self.cabeza
        while actual is not None:
            if actual.dato.id == id:
                return actual.dato
            actual = actual.siguiente
        return None

    def __iter__(self):
        actual = self.cabeza
        while actual is not None:
            yield actual.dato
            actual = actual.siguiente

class ErrorDeEquipoLeno(Excepcion):
    pass

class Equipo:
    def __init__(self):
        self.lista = ListaEnlazada()

    def agregar(self, pokemon):
        if self.lista.tamanio() >= 6:
            raise ErrorDeEquipoLeno("El equipo ya tiene 6 Pokémon.")
        self.lista.insertar_al_final(pokemon)

    def quitar(self, id):
        encontrado = self.lista.eliminar(id)
        if not encontrado:
            raise PokémonNoEncontrado(f"No se encontró el Pokémon con id {id} en el equipo.")

    def cantidad(self):
        return self.lista.tamanio()

    def __iter__(self):
        return iter(self.lista)
